# Copy to .env; never commit the real token.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=393943927
TELEGRAM_ADMIN_ID=393943927
KUFAR_LOOP_DELAY_SECONDS=300
KUFAR_QUERY_DELAY_SECONDS=5
KUFAR_CACHE_RETENTION_DAYS=180
KUFAR_CACHE_MAX_PER_USER=20000
KUFAR_CACHE_MAX_TOTAL=100000
# State writes are capped at 500 MiB, with a 64 MiB free-disk reserve.
# Docker log rotation and the 512 MiB RAM limit are set in compose.yaml.
# Optional: restore saved KUFAR_RECIPIENTS_JSON, unchanged.
# If no backup exists, add users and searches through the bot menu.
# Or store its JSON array in kufar-configuration.json under "recipients".
# KUFAR_RECIPIENTS_JSON='[{"chat-id":123,"queries":[]}]'
# KUFAR_BEARER_TOKEN=

# Copy to .env; never commit the real token.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=393943927
TELEGRAM_ADMIN_ID=393943927
KUFAR_LOOP_DELAY_SECONDS=300
KUFAR_QUERY_DELAY_SECONDS=5
KUFAR_CACHE_RETENTION_DAYS=180
KUFAR_CACHE_MAX_PER_USER=20000
KUFAR_CACHE_MAX_TOTAL=100000
# State writes are capped at 500 MiB, with a 64 MiB free-disk reserve.
# Docker log rotation and the 512 MiB RAM limit are set in compose.yaml.
# Optional: restore saved KUFAR_RECIPIENTS_JSON, unchanged.
# If no backup exists, add users and searches through the bot menu.
# Or store its JSON array in kufar-configuration.json under "recipients".
# KUFAR_RECIPIENTS_JSON='[{"chat-id":123,"queries":[]}]'
# KUFAR_BEARER_TOKEN=
# Optional: only Kufar API requests use this proxy. Keep real credentials in .env.
# The proxy must have working access to Kufar; an arbitrary proxy can still receive 403.
# With KUFAR_PROXY set, kufar-proxies.txt supplies the owner's four reserve proxies.
# The owner is alerted after 3 failed searches only when every route is unavailable.
# Override reserves with a semicolon-separated list (empty disables reserves):
# KUFAR_PROXY_POOL='http://PROXY_HOST:PORT;socks5h://SECOND_PROXY_HOST:PORT'
# Or read one proxy URL per line from a file mounted inside the container:
# KUFAR_PROXY_POOL_FILE=/data/private-proxies.txt
# HTTP, HTTPS, SOCKS4, SOCKS4a and SOCKS5 are supported.
# SOCKS4a and SOCKS5h resolve the destination through the proxy.
# KUFAR_PROXY=socks4://PROXY_HOST:PORT
# KUFAR_PROXY=socks5h://USER:PASSWORD@PROXY_HOST:PORT
